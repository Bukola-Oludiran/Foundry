{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry.local/schema/product-ir-v5.json",
  "title": "Foundry Recursive Product Architecture IR v5",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "product", "requirements"],
  "properties": {
    "version": { "const": 5 },
    "product": { "$ref": "#/$defs/node" },
    "requirements": { "type": "array", "maxItems": 8192, "items": { "$ref": "#/$defs/requirement" } },
    "scenarios": { "type": "array", "items": { "type": "object" } },
    "deployment": { "type": "object" },
    "stateModels": { "type": "array", "items": { "type": "object" } },
    "layouts": { "type": "array", "items": { "type": "object" } },
    "research": { "type": "array", "items": { "type": "object" } }
  },
  "$defs": {
    "segment": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$", "minLength": 1, "maxLength": 100 },
    "typedValue": { "oneOf": [{ "type": ["null", "boolean", "number", "string"] }, { "type": "array", "items": { "$ref": "#/$defs/typedValue" } }, { "type": "object", "additionalProperties": { "$ref": "#/$defs/typedValue" } }] },
    "requirement": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "text", "priority"], "properties": { "id": { "$ref": "#/$defs/segment" }, "kind": { "type": "string" }, "text": { "type": "string", "minLength": 1 }, "priority": { "enum": ["must", "should", "could"] } } },
    "operation": { "type": "object", "additionalProperties": false, "required": ["name", "signature"], "properties": { "name": { "$ref": "#/$defs/segment" }, "signature": { "type": "string", "minLength": 1 }, "description": { "type": "string" }, "parameters": { "type": "array", "items": { "type": "object" } }, "returns": { "type": "string" }, "properties": { "type": "array", "items": { "type": "string" } } } },
    "contract": { "type": "object", "additionalProperties": false, "required": ["id", "name", "operations"], "properties": { "id": { "$ref": "#/$defs/segment" }, "name": { "type": "string", "minLength": 1 }, "visibility": { "enum": ["public", "product"] }, "operations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/operation" } }, "types": { "type": "array", "items": { "type": "object" } } } },
    "scenario": { "type": "object", "additionalProperties": false, "required": ["id", "name", "covers", "steps"], "properties": { "id": { "$ref": "#/$defs/segment" }, "name": { "type": "string", "minLength": 1 }, "covers": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/segment" } }, "steps": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "operation", "arguments"], "properties": { "id": { "$ref": "#/$defs/segment" }, "operation": { "$ref": "#/$defs/segment" }, "receiver": { "type": "string" }, "arguments": { "type": "array", "items": { "$ref": "#/$defs/typedValue" } }, "bind": { "type": "string" }, "expect": { "type": "object" } } } } } },
    "capabilityRef": { "type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": { "id": { "$ref": "#/$defs/segment" }, "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }, "config": { "type": "object", "additionalProperties": { "$ref": "#/$defs/typedValue" } } } },
    "target": { "type": "object", "additionalProperties": false, "required": ["targetId", "path", "mediaType", "role"], "properties": { "targetId": { "$ref": "#/$defs/segment" }, "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" }, "mediaType": { "type": "string" }, "role": { "type": "string" } } },
    "implementation": { "type": "object", "additionalProperties": false, "required": ["targets"], "properties": { "targets": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/target" } }, "primaryTargetId": { "$ref": "#/$defs/segment" }, "entrypoint": { "type": "string" } } },
    "node": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "mandate", "contracts", "acceptance", "capabilityRefs"],
      "properties": {
        "id": { "$ref": "#/$defs/segment" }, "kind": { "enum": ["leaf", "composite"] },
        "mandate": { "type": "object", "additionalProperties": false, "required": ["outcome"], "properties": { "outcome": { "type": "string", "minLength": 1 }, "requirementIds": { "type": "array", "items": { "$ref": "#/$defs/segment" } } } },
        "contracts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/contract" } }, "constraints": { "type": "array", "items": { "type": "object" } },
        "acceptance": { "type": "array", "items": { "$ref": "#/$defs/scenario" } }, "capabilityRefs": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/capabilityRef" } },
        "deliverables": { "type": "array", "maxItems": 128, "items": { "type": "object" } }, "supersedes": { "type": "string" }, "implementation": { "$ref": "#/$defs/implementation" },
        "children": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/node" } }, "dependencies": { "type": "array", "items": { "type": "object" } },
        "dependencyExceptions": { "type": "array", "items": { "type": "object" } }, "allocations": { "type": "array", "items": { "type": "object" } }, "integration": { "type": "object" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "leaf" } } }, "then": { "required": ["implementation"], "not": { "anyOf": [{ "required": ["children"] }, { "required": ["integration"] }] } } },
        { "if": { "properties": { "kind": { "const": "composite" } } }, "then": { "required": ["children", "integration"], "not": { "required": ["implementation"] } } }
      ]
    }
  }
}
