{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry.local/schema/dyad-ir.json",
  "title": "Foundry Dyad IR",
  "description": "The formal, deterministically-compilable intermediate representation an architecture role emits. A flat list of nodes carrying two overlaid graphs: an ownership TREE (via `owner`) and a dependency DAG (via `requires`). Every node is a dyad: a doer implements `provides`; an independent tester verifies it against `acceptance`, whose mandate is owned by the node's parent (never the node itself).",
  "type": "object",
  "required": ["spec", "root", "nodes"],
  "additionalProperties": false,
  "properties": {
    "version": { "enum": [2, 3, 4], "description": "Canonical architecture IR revision. Omitted legacy documents normalize to v2 defaults; v4 uses typed acceptance scenarios." },
    "spec": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "language": {
          "type": "string",
          "description": "Default implementation language for leaves that don't override it (a Piston-supported runtime, e.g. 'python', 'typescript')."
        }
      }
    },
    "root": {
      "type": "string",
      "description": "Id of the root node. Its `owner` MUST be null; its `acceptance.mandate_owner` is 'spec' (the Chairman's top-level acceptance)."
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    },
    "requirements": { "type": "array", "items": { "$ref": "#/$defs/requirement" }, "default": [] },
    "scenarios": { "type": "array", "items": { "$ref": "#/$defs/scenario" }, "default": [] },
    "deployment": { "$ref": "#/$defs/deployment" },
    "stateModels": { "type": "array", "items": { "$ref": "#/$defs/stateModel" }, "default": [] },
    "layouts": { "type": "array", "items": { "$ref": "#/$defs/viewLayout" }, "default": [] },
    "research": { "type": "array", "items": { "$ref": "#/$defs/researchNote" }, "default": [] },
    "delivery": { "$ref": "#/$defs/deliveryProfile" }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "kind", "owner", "provides", "acceptance"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "kind": {
          "enum": ["leaf", "integrator"],
          "description": "leaf = the doer writes real code. integrator = the doer writes glue composing this node's children."
        },
        "owner": {
          "type": ["string", "null"],
          "description": "Parent (manager) node id — the ownership TREE edge. null only for `root`. The owner authors this node's acceptance mandate."
        },
        "provides": {
          "oneOf": [{ "$ref": "#/$defs/interface" }, { "type": "string", "minLength": 1 }],
          "description": "The single interface this node promises UPWARD to its owner. Held stable across interface-preserving re-architecture."
        },
        "requires": {
          "type": "array",
          "description": "Interfaces this node consumes. Each entry is a dependency-DAG edge (this node depends_on ref.node). Must reference an interface actually provided by an existing node.",
          "items": { "$ref": "#/$defs/interfaceRef" },
          "default": []
        },
        "implementation": { "$ref": "#/$defs/implementation" },
        "acceptance": {
          "$ref": "#/$defs/testBundle",
          "description": "The parent-owned, black-box acceptance suite the tester runs via Piston. Verifies `provides` (and, for integrators, composed behavior) — NOT the internals."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "leaf" } } },
          "then": {
            "properties": { "implementation": { "$ref": "#/$defs/leafImpl" } },
            "required": ["implementation"]
          }
        },
        {
          "if": { "properties": { "kind": { "const": "integrator" } } },
          "then": {
            "properties": { "implementation": { "$ref": "#/$defs/integratorImpl" } },
            "required": ["implementation"]
          }
        }
      ]
    },
    "interface": {
      "type": "object",
      "required": ["name", "operations"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/operation" }
        },
        "types": {
          "type": "array",
          "description": "Optional named type/shape definitions the operations reference.",
          "items": {
            "type": "object",
            "required": ["name", "definition"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "definition": { "type": "string" }
            }
          }
        }
      }
    },
    "operation": {
      "type": "object",
      "required": ["name", "signature"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "signature": {
          "type": "string",
          "description": "Language-neutral signature, e.g. 'slugify(s: string) -> string'."
        },
        "description": { "type": "string" },
        "properties": {
          "type": "array",
          "description": "Behavioral contract clauses (NOT just the type signature) — the leaky-interface guard. e.g. 'idempotent', 'output matches ^[a-z0-9-]+$'.",
          "items": { "type": "string" }
        },
        "parameters": { "type": "array", "items": { "$ref": "#/$defs/operationParameter" } },
        "returns": { "type": "string" },
        "http": { "type": "object", "required": ["method", "path"], "additionalProperties": false, "properties": { "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] }, "path": { "type": "string", "pattern": "^/" } } }
      }
    },
    "operationParameter": {
      "type": "object", "required": ["name", "type"], "additionalProperties": false,
      "properties": { "name": { "type": "string" }, "type": { "type": "string" } }
    },
    "interfaceRef": {
      "type": "object",
      "required": ["node", "interface"],
      "additionalProperties": false,
      "properties": {
        "node": { "type": "string", "description": "Id of the providing node." },
        "interface": { "type": "string", "description": "Name of that node's provided interface." }
      }
    },
    "leafImpl": {
      "type": "object",
      "required": ["language"],
      "additionalProperties": false,
      "properties": {
        "language": {
          "type": "string",
          "description": "A Piston-supported runtime the doer writes in (e.g. 'python', 'typescript')."
        },
        "write_target": {
          "type": "string",
          "description": "Repo-relative path/dir the doer may WRITE (the sandbox write scope). The doer's read-set is derived by the compiler = each required node's write_target, mounted read-only."
        },
        "targets": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/target" } },
        "primaryTargetId": { "type": "string" },
        "entrypoint": {
          "type": "string",
          "description": "Optional file within write_target that exports `provides`."
        }
      }
    },
    "integratorImpl": {
      "type": "object",
      "required": ["children"],
      "additionalProperties": false,
      "properties": {
        "children": {
          "type": "array",
          "minItems": 0,
          "description": "Ids of the child nodes this integrator composes. These are the ownership-TREE children (each child's `owner` must equal this node's id).",
          "items": { "type": "string" }
        },
        "write_target": {
          "type": "string",
          "description": "Repo-relative path/dir for the glue/composition code the integrator's doer writes."
        },
        "targets": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/target" } },
        "primaryTargetId": { "type": "string" },
        "composition": {
          "type": "string",
          "description": "Optional prose/pseudocode describing how children compose to satisfy `provides` (e.g. 'slugify(s) = hyphenate(trim(lower(s)))')."
        }
      }
    },
    "testBundle": {
      "type": "object",
      "required": ["mandate_owner", "language", "cases"],
      "additionalProperties": false,
      "properties": {
        "mandate_owner": {
          "type": "string",
          "description": "Id of the node that OWNS this acceptance mandate (the parent), or 'spec' for the root. Integrity rule: never equal to the node's own id — the doer cannot author its own exam."
        },
        "language": {
          "type": "string",
          "description": "Piston runtime the acceptance suite executes under."
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "description": "Deterministic, executable test cases (LeetCode-style). Each is judged pass/fail by Piston.",
          "items": { "$ref": "#/$defs/testCase" }
        },
        "scenarios": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/acceptanceScenario" } },
        "properties": {
          "type": "array",
          "description": "Optional property-based invariants to fuzz (behavioral contract, beyond fixed cases).",
          "items": { "type": "string" }
        },
        "perf": {
          "type": "object",
          "description": "Optional LeetCode-style resource limits enforced by Piston.",
          "additionalProperties": false,
          "properties": {
            "time_ms": { "type": "integer", "minimum": 1 },
            "mem_mb": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "target": {
      "type": "object", "required": ["targetId", "path", "mediaType", "role"], "additionalProperties": false,
      "properties": { "targetId": { "type": "string" }, "path": { "type": "string" }, "mediaType": { "type": "string" }, "role": { "enum": ["source", "entrypoint", "metadata", "documentation", "lockfile", "service-entrypoint", "migration"] } }
    },
    "deliveryProfile": { "oneOf": [
      { "type": "object", "required": ["profile", "integrationNode", "runtime", "sourceRoot", "distributionName", "publicModule", "dependencyPolicy", "metadataTargetId", "readmeTargetId"], "additionalProperties": false, "properties": {
        "profile": { "const": "python-library" }, "integrationNode": { "type": "string" }, "runtime": { "$ref": "#/$defs/pythonRuntime" }, "sourceRoot": { "type": "string" }, "distributionName": { "type": "string" }, "publicModule": { "type": "string" }, "dependencyPolicy": { "const": "none" }, "metadataTargetId": { "type": "string" }, "readmeTargetId": { "type": "string" }
      } },
      { "type": "object", "required": ["profile", "integrationNode", "runtime", "sourceRoot", "distributionName", "publicModule", "dependencyPolicy", "metadataTargetId", "readmeTargetId", "lockfileTargetId", "serviceEntrypointTargetId", "entrypoint", "healthRoute", "persistence", "migrationOperationId", "readinessOperationId"], "additionalProperties": false, "properties": {
        "profile": { "const": "python-service" }, "integrationNode": { "type": "string" }, "runtime": { "$ref": "#/$defs/pythonRuntime" }, "sourceRoot": { "type": "string" }, "distributionName": { "type": "string" }, "publicModule": { "type": "string" }, "dependencyPolicy": { "const": "locked" }, "metadataTargetId": { "type": "string" }, "readmeTargetId": { "type": "string" }, "lockfileTargetId": { "type": "string" }, "serviceEntrypointTargetId": { "type": "string" }, "entrypoint": { "type": "object", "required": ["module", "symbol"], "additionalProperties": false, "properties": { "module": { "type": "string" }, "symbol": { "type": "string" } } }, "healthRoute": { "type": "string", "pattern": "^/" }, "persistence": { "type": "object", "required": ["engine", "schemaVersion"], "additionalProperties": false, "properties": { "engine": { "const": "sqlite" }, "schemaVersion": { "type": "integer", "minimum": 1 } } }, "migrationOperationId": { "type": "string" }, "readinessOperationId": { "type": "string" }
      } }
    ] },
    "pythonRuntime": { "type": "object", "required": ["language", "versionRange"], "additionalProperties": false, "properties": { "language": { "const": "python" }, "versionRange": { "type": "string" } } },
    "requirement": {
      "type": "object", "required": ["id", "kind", "text"], "additionalProperties": false,
      "properties": { "id": { "type": "string" }, "kind": { "enum": ["functional", "quality", "constraint"] }, "text": { "type": "string" }, "priority": { "enum": ["must", "should", "could"] } }
    },
    "scenario": {
      "type": "object", "required": ["id", "name", "steps"], "additionalProperties": false,
      "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "critical": { "type": "boolean", "default": false }, "steps": { "type": "array", "items": { "$ref": "#/$defs/scenarioStep" } } }
    },
    "scenarioStep": {
      "type": "object", "required": ["from", "to", "message", "order"], "additionalProperties": false,
      "properties": { "from": { "type": "string" }, "to": { "type": "string" }, "message": { "type": "string" }, "order": { "type": "integer", "minimum": 0 } }
    },
    "deployment": {
      "type": "object", "required": ["nodes", "links"], "additionalProperties": false,
      "properties": {
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/deploymentNode" } },
        "links": { "type": "array", "items": { "$ref": "#/$defs/deploymentLink" } }
      }
    },
    "deploymentNode": {
      "type": "object", "required": ["id", "name", "kind"], "additionalProperties": false,
      "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "kind": { "enum": ["device", "process", "container", "service", "database", "external"] }, "hosts": { "type": "array", "items": { "type": "string" } }, "boundary": { "type": "string" } }
    },
    "deploymentLink": {
      "type": "object", "required": ["from", "to"], "additionalProperties": false,
      "properties": { "from": { "type": "string" }, "to": { "type": "string" }, "protocol": { "type": "string" }, "label": { "type": "string" } }
    },
    "stateModel": {
      "type": "object", "required": ["id", "subject", "initial", "states", "transitions"], "additionalProperties": false,
      "properties": { "id": { "type": "string" }, "subject": { "type": "string" }, "initial": { "type": "string" }, "states": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }, "transitions": { "type": "array", "items": { "$ref": "#/$defs/stateTransition" } } }
    },
    "stateTransition": {
      "type": "object", "required": ["from", "to", "event"], "additionalProperties": false,
      "properties": { "from": { "type": "string" }, "to": { "type": "string" }, "event": { "type": "string" } }
    },
    "viewLayout": {
      "type": "object", "required": ["viewId", "positions"], "additionalProperties": false,
      "properties": { "viewId": { "type": "string" }, "positions": { "type": "object", "additionalProperties": { "$ref": "#/$defs/layoutBox" } } }
    },
    "layoutBox": {
      "type": "object", "required": ["x", "y"], "additionalProperties": false,
      "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 } }
    },
    "researchNote": {
      "type": "object", "required": ["claim", "source", "accessedAt"], "additionalProperties": false,
      "properties": { "claim": { "type": "string" }, "source": { "type": "string" }, "accessedAt": { "type": "string", "format": "date-time" } }
    },
    "testCase": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "call": {
          "type": "string",
          "description": "Expression exercising `provides`, e.g. \"slugify('  Hello World! ')\"."
        },
        "expect": {
          "description": "Expected result of `call` (any JSON value)."
        },
        "harness": {
          "type": "string",
          "description": "Optional full test-body source (for cases that need setup/state beyond call/expect)."
        },
        "covers": { "type": "array", "uniqueItems": true, "items": { "type": "string" }, "description": "Requirement IDs exercised by this case." }
      }
    },
    "acceptanceScenario": {
      "type": "object", "required": ["id", "name", "covers", "steps"], "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "covers": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/acceptanceStep" } }
      }
    },
    "acceptanceStep": {
      "type": "object", "required": ["id", "operation", "arguments"], "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "operation": { "type": "string", "minLength": 1 },
        "receiver": { "type": "string", "minLength": 1 },
        "arguments": { "type": "array", "items": { "$ref": "#/$defs/typedValue" } },
        "bind": { "type": "string", "minLength": 1 },
        "expect": { "$ref": "#/$defs/expectation" }
      }
    },
    "typedValue": {
      "oneOf": [
        { "type": ["null", "boolean", "number", "string"] },
        { "type": "array", "items": { "$ref": "#/$defs/typedValue" } },
        { "type": "object", "required": ["$ref"], "additionalProperties": false, "properties": { "$ref": { "type": "string", "minLength": 1 } } },
        { "type": "object", "required": ["$type", "value"], "additionalProperties": false, "properties": { "$type": { "enum": ["datetime", "decimal", "bytes"] }, "value": { "type": "string" } } },
        { "type": "object", "propertyNames": { "not": { "enum": ["$ref", "$type"] } }, "additionalProperties": { "$ref": "#/$defs/typedValue" } }
      ]
    },
    "expectation": {
      "oneOf": [
        { "type": "object", "required": ["kind", "value"], "additionalProperties": false, "properties": { "kind": { "enum": ["equals", "subset"] }, "value": { "$ref": "#/$defs/typedValue" } } },
        { "type": "object", "required": ["kind", "errorType"], "additionalProperties": false, "properties": { "kind": { "const": "error" }, "errorType": { "type": "string", "minLength": 1 }, "messageIncludes": { "type": "string" } } }
      ]
    }
  }
}
