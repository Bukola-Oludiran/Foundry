{
  "name": "foundry-control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test:mcp": "node --import tsx --test src/**/*.test.ts",
