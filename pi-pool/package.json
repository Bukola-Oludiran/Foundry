{
  "name": "@foundry/pi-pool",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Foundry data-plane worker pool: /build (doer, pi) + /test (tester, deterministic → Piston).",
  "scripts": {
    "format": "prettier --write 'src/**/*.ts' 'scripts/**/*.ts' 'fixtures/**/*.{js,mjs,json}' package.json tsconfig.json",
    "format:check": "prettier --check 'src/**/*.ts' 'scripts/**/*.ts' 'fixtures/**/*.{js,mjs,json}' package.json tsconfig.json",
    "typecheck": "tsc --noEmit",
    "validate:ir": "node scripts/validate-ir.ts",
    "validate:languages": "node scripts/validate-language-backends.ts",
    "validate:evidence": "node scripts/validate-evidence.ts",
    "validate:dependency-resolution": "node scripts/validate-dependency-resolution.ts",
    "validate:dependency-resolver-command": "node scripts/validate-dependency-resolver-command.ts",
    "validate:environment-manager": "node scripts/validate-environment-manager.ts",
    "validate:environment-controller": "node scripts/validate-environment-controller.ts",
    "validate:integration-emulator": "node scripts/validate-integration-emulator.ts",
    "validate:runtime-images": "node scripts/validate-runtime-images.ts",
    "validate:package-backends": "node scripts/validate-package-backends.ts",
    "validate:project-runner": "node scripts/validate-project-runner.ts",
    "validate:project-runner-service": "node scripts/validate-project-runner-service.ts",
    "validate:doer-tools": "node scripts/validate-doer-tools.ts",
    "validate:runner-gen": "node scripts/validate-runner-gen.ts",
    "validate:sandbox": "node scripts/validate-sandbox.ts",
    "validate:build": "node scripts/validate-build.ts",
    "validate:architect": "node scripts/validate-architect.ts",
    "validate:server": "node scripts/validate-server.ts",
    "validate:security": "node scripts/validate-worker-security.ts",
    "validate:worker-restart": "node scripts/validate-worker-restart.ts",
    "validate:v2-server": "node scripts/validate-v2-server.ts",
    "validate:worker-v2": "node scripts/validate-worker-v2.ts",
    "validate:durable-restart": "node scripts/validate-durable-restart.ts",
    "validate:live-polyglot": "node scripts/validate-live-polyglot.ts",
    "validate:oci": "node scripts/validate-oci-sandbox.ts",
    "test": "npm run typecheck && npm run validate:ir && npm run validate:runner-gen && npm run validate:languages && npm run validate:evidence && npm run validate:dependency-resolution && npm run validate:dependency-resolver-command && npm run validate:package-backends && npm run validate:environment-manager && npm run validate:environment-controller && npm run validate:integration-emulator && npm run validate:runtime-images && npm run validate:project-runner && npm run validate:project-runner-service && npm run validate:worker-v2 && npm run validate:doer-tools && npm run validate:architect && npm run validate:security && npm run validate:worker-restart && npm run validate:v2-server",
    "test:local": "npm test && npm run validate:sandbox && npm run validate:build && npm run validate:server"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "ajv": "8.20.0",
    "typescript-legacy": "npm:typescript@5.9.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
