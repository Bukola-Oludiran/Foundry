FROM docker.io/library/docker@sha256:851f91d241214e7c6db86513b270d58776379aacc5eb9c4a87e5b47115e3065c AS docker_cli
FROM docker.io/library/node@sha256:aadf416b2cdce311a8811ba3f0608a61b77dbf997500e2eafe781b51f6a0b019

WORKDIR /app
COPY --from=docker_cli /usr/local/bin/docker /usr/local/bin/docker
COPY pi-pool/package.json pi-pool/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY pi-pool/src ./src

ENV NODE_ENV=production PORT=8080
EXPOSE 8080
ENTRYPOINT ["node", "/app/src/runtime/project-runner-server.ts"]
