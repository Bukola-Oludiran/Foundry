# Copy to .env and set the key locally. .env is gitignored.
ANTHROPIC_API_KEY=

# MCP-native server
FOUNDRY_DATA_DIR=/tmp/foundry-data
FOUNDRY_WORKSPACE_ROOTS=workspace=/path/to/allowed/root
FOUNDRY_ENGINE_BIN=gr-host/target/debug/foundry-engine-sidecar
FOUNDRY_WORKER_URL=http://127.0.0.1:8787
# Certification-only until HashRelay, performance, security, and two-client gates pass.
FOUNDRY_PRODUCT_IR_V5=disabled

# Hosted MCP: configure OIDC in production. Static bearer is local-only.
FOUNDRY_OIDC_ISSUER=
FOUNDRY_OIDC_AUDIENCE=
FOUNDRY_OIDC_JWKS_URL=
FOUNDRY_HTTP_BEARER_TOKEN=
FOUNDRY_ALLOWED_HOSTS=127.0.0.1,localhost
FOUNDRY_ALLOWED_ORIGIN_HOSTS=127.0.0.1,localhost

# Legacy/control provider (disabled unless FOUNDRY_ENABLE_LEGACY_PROVIDER=1)
FOUNDRY_ENABLE_LEGACY_PROVIDER=0
FOUNDRY_LLM_PROVIDER=anthropic
FOUNDRY_LLM_MODEL=claude-sonnet-4-6
FOUNDRY_TESTER=piston
PISTON_URL=http://127.0.0.1:2000
PORT=8811
