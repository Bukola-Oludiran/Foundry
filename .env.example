# MCP workspace IDs map to operator-approved absolute roots.
FOUNDRY_WORKSPACE_ROOTS=foundry=/absolute/path/to/Foundry

# Optional when the default gr-host/target/debug/foundry-host path is used.
FOUNDRY_HOST_BIN=
# The versioned Rust sidecar is the default. Use direct only for development diagnostics.
FOUNDRY_HOST_TRANSPORT=sidecar

# Worker authentication and provider configuration remain environment-only.
FOUNDRY_WORKER_TOKEN=
FOUNDRY_LLM_PROVIDER=
FOUNDRY_LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Draft publication uses the standard GitHub CLI credential environment.
GH_TOKEN=
